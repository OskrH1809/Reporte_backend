DATABASE_URL=sqlite:////data/app.db
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173
JORNADA_SEMANA=8
JORNADA_SABADO=5
MAX_FOTO_MB=15

# --- Producción (Render + Supabase) ---
# Supabase: usar la URL del *session pooler* (IPv4); la conexión directa es IPv6 y Render no la alcanza.
# DATABASE_URL=postgresql://usuario:contrasena@aws-0-region.pooler.supabase.com:5432/postgres
# Inicio de sesión (obligatorio en producción).
AUTENTICACION=false
JWT_MINUTOS=480
# Mínimo 32 caracteres; en Render se genera solo. Vacío en local.
JWT_SECRETO=

# Administradores que crean las semillas: lista JSON con correo y HASH argon2 (nunca la contraseña).
# Generar el hash: docker compose run --rm api python -m app.cli hash-contrasena
# Ejemplo ficticio: [{"correo":"admin@ejemplo.com","contrasena_hash":"$argon2id$v=19$..."}]
ADMINS_SEMILLA=[]
